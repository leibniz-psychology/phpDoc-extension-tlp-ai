{% if node.tags['ai-tlp'] is defined %}
    {% for tag in node.tags['ai-tlp'] %}
        <div class="phpdocumentor-tag-ai-tlp phpdocumentor-tag-ai-tlp--{{ tag.level }}">
            <span class="phpdocumentor-tag-ai-tlp__badge">{{ tag.fullLabel }}</span>
            {% if tag.description %}
                <span class="phpdocumentor-tag-ai-tlp__description">{{ tag.description|markdown|raw }}</span>
            {% endif %}
        </div>
    {% endfor %}
{% endif %}

<style>
.phpdocumentor-tag-ai-tlp {
    display: flex;
    align-items: center;
    margin-bottom: 1em;
    padding: 0.5em;
    border-radius: 4px;
    border: 1px solid #ddd;
}
.phpdocumentor-tag-ai-tlp__badge {
    font-weight: bold;
    padding: 0.2em 0.6em;
    border-radius: 3px;
    margin-right: 1em;
    color: #fff;
    text-transform: uppercase;
}
.phpdocumentor-tag-ai-tlp--white { border-color: #ccc; }
.phpdocumentor-tag-ai-tlp--white .phpdocumentor-tag-ai-tlp__badge { background-color: #f0f0f0; color: #333; border: 1px solid #ccc; }
.phpdocumentor-tag-ai-tlp--green { border-color: #28a745; }
.phpdocumentor-tag-ai-tlp--green .phpdocumentor-tag-ai-tlp__badge { background-color: #28a745; }
.phpdocumentor-tag-ai-tlp--amber { border-color: #ffbf00; }
.phpdocumentor-tag-ai-tlp--amber .phpdocumentor-tag-ai-tlp__badge { background-color: #ffbf00; color: #000; }
.phpdocumentor-tag-ai-tlp--orange { border-color: #fd7e14; }
.phpdocumentor-tag-ai-tlp--orange .phpdocumentor-tag-ai-tlp__badge { background-color: #fd7e14; }
.phpdocumentor-tag-ai-tlp--red { border-color: #dc3545; }
.phpdocumentor-tag-ai-tlp--red .phpdocumentor-tag-ai-tlp__badge { background-color: #dc3545; }
.phpdocumentor-tag-ai-tlp--yolo { border-color: #6f42c1; border-style: dashed; }
.phpdocumentor-tag-ai-tlp--yolo .phpdocumentor-tag-ai-tlp__badge { background-color: #6f42c1; background-image: linear-gradient(45deg, #6f42c1, #e83e8c); }
</style>
