{
    "name": "leibniz-psychology/phpdoc-extension-tlp-ai",
    "description": "A phpDocumentor extension to document AI usage according to the AI traffic light protocol.",
    "type": "phpdocumentor-extension",
    "license": "MIT",
    "authors": [
        {
            "name": "Junie",
            "email": "junie@jetbrains.com"
        }
    ],
    "require": {
        "php": ">=8.1",
        "phpdocumentor/phpdocumentor": "^3.3"
    },
    "require-dev": {
        "phpunit/phpunit": "^10.5",
        "phpstan/phpstan": "^1.12",
        "squizlabs/php_codesniffer": "^3.10"
    },
    "autoload": {
        "psr-4": {
            "LeibnizPsychology\\PhpDocAiTlp\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "LeibnizPsychology\\PhpDocAiTlp\\Tests\\": "tests/"
        }
    },
    "config": {
        "allow-plugins": {
            "php-http/discovery": true
        }
    }
}
